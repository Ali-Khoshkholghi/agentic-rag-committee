TAVILY_API_KEY=
LIT_SEARCH_PROVIDER=tavily

GEMINI_API_KEY=
SYNTHESIS_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.6-flash

# critic: naive keyword-overlap checker, or LangGraph + Gemini verifier.
# Defaults to langgraph if GEMINI_API_KEY is set and CRITIC_MODE is left
# unset, otherwise naive — same zero-key-required principle as every
# other provider toggle above.
CRITIC_MODE=langgraph
